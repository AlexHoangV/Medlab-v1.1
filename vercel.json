{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "styles/**",
          "js/**",
          "*.html",
          "medlab_db.json",
          "logo.svg",
          "assets/**",
          ".env.example"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
